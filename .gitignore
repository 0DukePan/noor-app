# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# AGP 8.x writes root-project artifacts here even though Flutter points the
# root buildDir at ../build
/android/build/

# Release signing (never commit the real key!)
android/key.properties
android/app/*.jks
android/app/*.keystore


# Test coverage
coverage/

# Generated prebuilt hadith database
assets/db/hadith.db

# Generated Flutter golden-test failure diagnostics
# Approved baselines belong in test/goldens/; failure artifacts do not.
test/failures/
test_run_output.txt

# Assistant/tool-local state (Command Code taste + session data)
.commandcode/
